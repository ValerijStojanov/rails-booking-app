<main class="parking-areas-page parking-areas-index-page">
  <header class="parking-areas-header">
    <a class="parking-brand" href="<%= parking_areas_path %>" aria-label="Parking home">
      <span class="parking-brand-mark" aria-hidden="true">P</span>
      <span>Parking</span>
    </a>
  </header>

  <div class="parking-areas-browser">
    <section class="parking-map-placeholder" aria-label="Decorative parking area map">
      <%= image_tag "map.svg",
              alt: "",
              class: "parking-map-image",
              aria: { hidden: true } %>

      <div class="parking-map-locations">
        <% @parking_areas.each do |parking_area| %>
          <%= link_to parking_area,
                  class: "parking-map-location",
                  aria: { label: "View #{parking_area.name}" } do %>
            <span class="parking-map-location-pin" aria-hidden="true"></span>
            <span class="parking-map-location-name"><%= parking_area.name %></span>
          <% end %>
        <% end %>
      </div>

    </section>

    <section class="parking-areas-section" aria-labelledby="parking-areas-title">
      <div class="parking-areas-heading">
        <div>
          <p class="parking-areas-eyebrow">Choose a location</p>
          <h1 id="parking-areas-title">Parking areas</h1>
        </div>

        <%= link_to "New parking area", new_parking_area_path, class: "parking-areas-new-link" %>
      </div>

      <ul class="parking-areas-list">
        <% @parking_areas.each do |parking_area| %>
          <li class="parking-area-card">
            <%= link_to parking_area, class: "parking-area-link" do %>
              <span class="parking-area-icon" aria-hidden="true">P</span>
              <span class="parking-area-details">
                <strong><%= parking_area.name %></strong>
              </span>
              <span class="parking-area-arrow" aria-hidden="true">&rarr;</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  </div>
</main>

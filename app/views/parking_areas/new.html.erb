<main class="parking-area-new-page">
  <header class="parking-area-new-header">
    <nav class="parking-breadcrumbs" aria-label="<%= t("application.breadcrumb_label") %>">
      <ol>
        <li><%= link_to t("navigation.parking_areas"), parking_areas_path %></li>
        <li aria-current="page"><%= t("navigation.new_parking_area") %></li>
      </ol>
    </nav>

    <a class="parking-brand" href="<%= parking_areas_path %>" aria-label="<%= t("application.home_label") %>">
      <span class="parking-brand-mark" aria-hidden="true">P</span>
      <span><%= t("application.name") %></span>
    </a>
  </header>

  <section class="parking-area-form-card" aria-labelledby="new-parking-area-title">
    <div class="parking-area-form-heading">
      <p class="parking-areas-eyebrow"><%= t(".eyebrow") %></p>
      <h1 id="new-parking-area-title"><%= t(".title") %></h1>
      <p><%= t(".description") %></p>
    </div>

    <% if @parking_area.errors.any? %>
      <div class="form-validation-errors" role="alert">
        <ul>
          <% @parking_area.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @parking_area, class: "parking-area-form" do |form| %>
      <div class="parking-form-field">
        <%= form.label :name %>
        <%= form.text_field :name %>
      </div>

      <div class="parking-form-field">
        <%= form.label :capacity %>
        <%= form.number_field :capacity %>
      </div>

      <%= form.submit class: "parking-form-submit" %>
    <% end %>
  </section>
</main>
